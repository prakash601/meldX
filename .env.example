DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx.neon.tech/meldx?ssl=require
# Integration tests only use DATABASE_URL_TEST (never fall back to production).
DATABASE_URL_TEST=postgresql+asyncpg://user:pass@ep-xxx.neon.tech/meldx_test?ssl=require
API=http://localhost:8000
LEASE_MINUTES=30

# Capability flags (product plan §6.1): the standalone personal service boots with
# the MCP transport and the agent-execution routes (claim/handoff) OFF. MCP is
# aligned with the finished service at v0.0.5; execution coordination at v0.0.7.
ENABLE_MCP=false
ENABLE_AGENT_EXECUTION=false

# Owner timezone (IANA name). "Today", "tomorrow 9am", and day boundaries are
# interpreted in this zone; stored instants stay UTC, dates stay calendar
# dates. Unknown values fail at startup rather than silently falling back.
OWNER_TIMEZONE=Asia/Kolkata
# Local dev (docker): DATABASE_URL=postgresql+asyncpg://meldx:meldx@localhost:5432/meldx

# Local dev with no database server to run. Tables are created on first boot from
# the model metadata; Alembic migrations are Postgres-only. Claims use a single
# atomic UPDATE instead of FOR UPDATE SKIP LOCKED, so the race suite still needs
# Postgres. Dev-only; never point a deployment at this.
# DATABASE_URL=sqlite+aiosqlite:///./meldx.db

# Run a single uvicorn worker: the SSE broadcast bus is in-process.
# Web assets use CDN HTMX + SSE + Tailwind; no frontend build or extra config.

# Render supplies RENDER_EXTERNAL_HOSTNAME automatically for MCP host validation.
# For a custom public domain, set MCP_HOSTNAME to its hostname (no scheme or port).
# MCP_HOSTNAME=todos.example.com
# Docker startup binds to PORT (default 8000; Render supplies its port).
