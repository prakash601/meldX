DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx.neon.tech/meldx?ssl=require
# Integration tests only use DATABASE_URL_TEST (never fall back to production).
DATABASE_URL_TEST=postgresql+asyncpg://user:pass@ep-xxx.neon.tech/meldx_test?ssl=require
API=http://localhost:8000
LEASE_MINUTES=30
# Local dev (docker): DATABASE_URL=postgresql+asyncpg://meldx:meldx@localhost:5432/meldx

# Run a single uvicorn worker: the SSE broadcast bus is in-process.
# Web assets use CDN HTMX + SSE + Tailwind; no frontend build or extra config.

# Render supplies RENDER_EXTERNAL_HOSTNAME automatically for MCP host validation.
# For a custom public domain, set MCP_HOSTNAME to its hostname (no scheme or port).
# MCP_HOSTNAME=todos.example.com
# Docker startup binds to PORT (default 8000; Render supplies its port).
